{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true,
    "jest": true
  },

  //use rbnb style
  "extends": ["airbnb-base"],
  "rules": {
    "no-unused-vars": "warn",
    "eqeqeq": "error",
    "no-empty-function": "warn",
    "consistent-return": "warn",
    "camelcase": "warn",
    "no-unreachable": "error"
  }
}
